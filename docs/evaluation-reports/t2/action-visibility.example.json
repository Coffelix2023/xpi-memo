{
  "purpose": "记忆动作状态可见性模型示例：6 类动作 × 3 档呈现，以及交互边界用例。断言由 scripts/t2-contract-check.ts 执行（V1-V4）。",
  "version": "1.0.0",
  "boundaryCases": [
    {
      "case": "B1",
      "description": "普通捕获完成",
      "evidence": "捕获路径只调 setFooterStatus（src/index.ts:417），不触碰 ui.select/confirm/custom",
      "mayOpenPrompt": false,
      "path": "capture"
    },
    {
      "case": "B2",
      "description": "T2 adapter 失败或降级",
      "evidence": "失败路径写 audit(fallback) 与 L0 事件；对话框调用点仅 index.ts:681、console.ts:588、status-panel.ts:458",
      "mayOpenPrompt": false,
      "path": "t2-failure"
    },
    {
      "case": "B3",
      "description": "后端整体不可用，recall 返回空 + warning",
      "evidence": "src/search/selector.ts：无后端时返回 warning 与空结果，不抛异常",
      "mayOpenPrompt": false,
      "path": "backend-unavailable"
    },
    {
      "case": "B4",
      "description": "非 TUI 模式（print / json）下候选生成",
      "evidence": "chooseCandidateAction 首行 if (ctx.mode !== \"tui\") return \"later\"（src/index.ts:672）",
      "mayOpenPrompt": false,
      "path": "non-tui-candidate"
    },
    {
      "case": "B5",
      "description": "用户在控制台 Pending 复核里处理候选",
      "evidence": "chooseCandidateAction force=true（src/index.ts:2144-2148）→ ctx.ui.select（src/index.ts:681）",
      "mayOpenPrompt": true,
      "path": "candidate-confirm"
    }
  ],
